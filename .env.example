# Public site URL — used for metadata, canonicals, sitemap, OG tags.
# Set this in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://apexitskills.com

# ── Lead delivery (optional) ──
# The /api/lead route is stubbed by default. To deliver leads for real,
# wire up ONE of these in src/app/api/lead/route.ts and set the secret here.
# RESEND_API_KEY=          # email delivery via Resend
# SHEET_WEBHOOK_URL=       # Google Apps Script webhook
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── CMS revalidation (optional, future) ──
# Secret for the /api/revalidate webhook when a CMS is connected.
# REVALIDATE_SECRET=
